<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <groupId>com.wejava</groupId>
    <artifactId>wejava-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>war</packaging>
    <name>wejava-backend</name>
    <description>WeJava 管理后台</description>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.18</mybatis-plus.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <spotless.version>2.46.1</spotless.version>

        <!--
          安全补丁：覆盖 Spring Boot 4.1.2 管理的版本
          （4.1.2 已是 4.1.x 最新，没有更高补丁可升，只能在这里定点覆盖）

          logback      CVE-2026-19880  受影响 0.9.14–1.6.2，修复于 1.6.3
          jackson 3    CVE-2026-110879（PolymorphicTypeValidator 绕过）
          jackson 2    同上（Jackson 2 线）
          mysql        CVE-2026-60586 / 60623 / 60624 / 61082，受影响至 9.7.x
        -->
        <logback.version>1.6.6</logback.version>
        <jackson-bom.version>3.1.8</jackson-bom.version>
        <jackson-2-bom.version>2.21.8</jackson-2-bom.version>
        <mysql.version>26.10.0</mysql.version>
        <asm.version>9.11.1</asm.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 未管理 asm，这里定点升级（test 作用域，来自 json-smart → accessors-smart） -->
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>${asm.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 接口文档：springdoc 3.x 对应 Spring Boot 4，生产环境通过配置关闭 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!-- war 部署：内嵌容器由外部 Tomcat 提供 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Boot 4 不再从 classpath 自动配置 Flyway，必须显式引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <!-- Flyway 10+ 的数据库方言拆成独立模块，MySQL 必须单独引 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- MyBatis-Plus：Boot 4 专用 starter（3.5.13+ 才有） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- 3.5.9+ 插件被拆成可选依赖，分页/数据权限必须显式引这个 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- Boot 4 把 -aop 改名为 -aspectj -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 只用到 JWS 编解码工具，不引入 OAuth2 授权服务器 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MapStruct：Entity / DTO / VO 之间的转换，编译期生成，无反射 -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot 4 把 MockMvc 相关自动配置拆到了独立模块 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- 仅 Android 使用的 JSON 实现，上游已停止维护（CVE-2026-110974 无修复版本），
                     JVM 上的 json-path 走 json-smart，排除后测试照常运行 -->
                <exclusion>
                    <groupId>com.vaadin.external.google</groupId>
                    <artifactId>android-json</artifactId>
                </exclusion>
                <!-- json-path 的唯一用途是 MockMvc 的 jsonPath 断言，我们只用了一处，
                     已改成 Hamcrest 字符串断言。整条排除后 json-smart / accessors-smart
                     也不再进入测试类路径，CVE-2026-113602 随之消失 -->
                <exclusion>
                    <groupId>com.jayway.jsonpath</groupId>
                    <artifactId>json-path</artifactId>
                </exclusion>
                <!-- starter-test 直接声明了 json-smart（供 json-path 断言用）。
                     本项目已不再使用 JSON 路径断言，排除后 CVE-2026-113602 不再出现在依赖树里。
                     上游 2.6.0 即最新版，暂无修复版本 -->
                <exclusion>
                    <groupId>net.minidev</groupId>
                    <artifactId>json-smart</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <profiles.active>dev</profiles.active>
                <war.name>dev#api</war.name>
            </properties>
        </profile>
        <!-- 容器化演示：前后端都走根路径，产物名不带 #（无需部署到 Tomcat） -->
        <profile>
            <id>docker</id>
            <properties>
                <profiles.active>docker</profiles.active>
                <war.name>wejava</war.name>
            </properties>
        </profile>

        <profile>
            <id>prod</id>
            <properties>
                <profiles.active>prod</profiles.active>
                <war.name>prod#api</war.name>
            </properties>
        </profile>
    </profiles>

    <build>
        <finalName>${war.name}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Lombok + MapStruct 同时作为注解处理器，顺序不能乱 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- 代码格式化：mvn spotless:apply -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <palantirJavaFormat/>
                        <removeUnusedImports/>
                        <importOrder/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
