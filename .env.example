# 复制为 .env 后按需修改：cp .env.example .env
# 所有变量都有默认值，不改也能直接 docker compose up -d

# 访问端口（宿主机）
WEB_PORT=3300

# 数据库
DB_NAME=wejava
DB_USER=wejava
DB_PASSWORD=wejava123456
MYSQL_ROOT_PASSWORD=root123456

# Redis
REDIS_PASSWORD=wejava123456

# 应用密钥（生产环境务必改成随机值）
JWT_SECRET=wejava-docker-demo-secret-key-32chars!!
AI_CONFIG_SECRET=wejava-docker-demo-ai-secret-32b!!

# 是否启用登录验证码
CAPTCHA_ENABLED=true

# 时区
TZ=Asia/Shanghai
